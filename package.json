{
  "name": "his-tracks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:all": "vite build && tsc -p server/tsconfig.json",
