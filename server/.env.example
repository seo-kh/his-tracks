# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Application type: Web application

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Cloud Console에 등록한 redirect URI와 정확히 일치해야 함
# 로컬: http://localhost:3000/auth/google/callback
# 운영: https://your-domain.com/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ── Client ────────────────────────────────────────────────────────────────────
# 인증 완료 후 리다이렉트할 SPA 주소
# 로컬 개발: http://localhost:5173  (Vite dev server)
# 운영:      /                       (Express가 동일 origin 서빙)
CLIENT_REDIRECT_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173