# ── His Tracks 환경 변수 설정 (.env) ──────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# 애플리케이션 유형: 웹 애플리케이션 (Web application)

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Cloud Console "승인된 리디렉션 URI"에 등록한 주소와 일치해야 합니다:
# - 로컬 개발: http://localhost:3000/auth/google/callback
# - Vercel 운영: https://<your-vercel-domain>.vercel.app/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ── Client / Redirect ─────────────────────────────────────────────────────────
# OAuth 완료 후 리다이렉트할 경로 (동일 도메인 서빙 시 "/" 권장)
CLIENT_REDIRECT_URL=/
CLIENT_ORIGIN=http://localhost:3000

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# 프론트엔드 단독 PKCE/Implicit OAuth 사용 시
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
